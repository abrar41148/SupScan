flowchart TD
    Start([Scan and report already work]) --> Cache["Cache OSV answers for 24 hours"]
    Cache --> Npm["Fix npm dev and prod labels"]
    Npm --> Hydrate["Fetch full advisories together"]
    Hydrate --> Pnpm["Read a pnpm lock, or say it was not understood"]
    Pnpm --> GoReplace["Mark a Go replace as unchecked"]
    GoReplace --> Cargo["Look up the real crates.io name"]
    Cargo --> Screen["Ignore list and scan comparison, on a screen"]
    Screen --> Composer["Read composer.lock"]
    Composer --> Pub["Read pubspec.lock"]
    Pub --> Ruby["Read Gemfile.lock"]
    Ruby --> Yarn["Read yarn.lock after the other JavaScript locks"]
    Yarn --> Gradle["Read a Gradle lock or version catalog"]
    Gradle --> Maven["Read literal versions in pom.xml"]
    Maven --> VersionSort["Sort a pre-release the way its package manager does"]
    VersionSort --> NoCheckout["Clone without checking files out"]
    NoCheckout --> Parallel["Scan several repositories at once"]
    Parallel --> Parked["Leave direct-only and offline listing"]

    classDef done fill:#90EE90,stroke:#333,stroke-width:2px,color:darkgreen
    classDef next fill:#87CEEB,stroke:#333,stroke-width:2px,color:darkblue
    classDef later fill:#E6E6FA,stroke:#333,stroke-width:2px,color:darkblue
    classDef parked fill:#FFD700,stroke:#333,stroke-width:2px,color:black

    class Start,Cache,Npm,Hydrate,Pnpm,GoReplace,Cargo,Screen,Composer,Pub,Ruby,Yarn,Gradle,Maven,VersionSort,NoCheckout,Parallel done
    class Parked parked
